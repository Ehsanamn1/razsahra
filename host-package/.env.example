# Copy to .env only if your hosting panel supports environment files.
# Never commit real credentials.
PORT=3000
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=razsahra
DB_USER=razsahra_user
DB_PASSWORD=replace-with-host-generated-password
SESSION_DAYS=14
ADMIN_BOOTSTRAP_SECRET=replace-with-at-least-32-random-characters
# Required for Medar login and operations. The Node server proxies /api/medar/* to this HTTPS origin.
# Keep the origin only: no path, credentials, query, or trailing slash.
MEDAR_API_ORIGIN=https://medar-ops.dengxiao445.workers.dev
