{
  "name": "raz-sahra-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "node --check 'functions/api/[[path]].js' && node --check assets/raz-sahra-cms-runtime.js && node scripts/check.mjs",
    "dev": "wrangler pages dev dist",
    "migrate:cms:dry-run": "node scripts/migrate-cms-data.mjs",
    "migrate:cms:apply": "node scripts/migrate-cms-data.mjs --apply"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.0",
    "mysql2": "^3.15.3"
  },
  "devDependencies": {
    "wrangler": "^4.151.3"
  }
}
